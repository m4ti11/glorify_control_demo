[Unit]
Description=Glorify Control native VPS agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=glorify-agent
Group=glorify-agent
WorkingDirectory=/opt/glorify-control-agent
EnvironmentFile=/etc/glorify-control-agent/agent.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/glorify-control-agent/venv/bin/glorify-control-agent run
Restart=always
RestartSec=15
TimeoutStopSec=90
StateDirectory=glorify-control-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/glorify-control-agent
StandardOutput=journal
StandardError=journal
SyslogIdentifier=glorify-control-agent

[Install]
WantedBy=multi-user.target
